    <string name="routecheck_ruleset_sim">Simulate rule-set match</string>
    <string name="routecheck_ruleset_none">none</string>
    <string name="routecheck_run">Check</string>
    <string name="routecheck_action_reject">Rejected — connection will be blocked</string>
    <string name="routecheck_action_hijack">DNS hijack — query goes to the built-in resolver</string>
    <string name="routecheck_action_route">Routes to: %1$s</string>
    <string name="routecheck_err_compile">Could not compile the current rule table — check the rule editor for errors.</string>
    <string name="routecheck_err_native">The Rust engine is unavailable on this install.</string>
    <string name="routecheck_note">The check replays the compiled rule table, including built-in entries (private IPs, DNS hijack, unknown-traffic exit) — the same table the kernel loads when you connect.</string>
    <string name="settings_battery_desc">Recommended on ColorOS/realme UI and other vendors that aggressively kill VPN apps. Doze deep-suspend is handled automatically either way: the tunnel is paused in Doze and resumes on wake.</string>
    <string name="settings_tls_fragment">TLS fragmentation (DPI hardening)</string>
    <string name="settings_tls_fragment_none">Off</string>
    <string name="settings_tls_fragment_record">Record split (fast)</string>
    <string name="settings_tls_fragment_packet">Packet split (strong)</string>
    <string name="settings_tls_fragment_desc">Splits the TLS ClientHello so middleboxes cannot regex-match the SNI. Record split is cheap and preferred; packet split is stronger but slower — enable only on censored networks.</string>
    <string name="settings_ntp">Clock sync (NTP)</string>
    <string name="settings_ntp_desc">Reality and shadowsocks-2022 reject handshakes outside a ±30 s clock window; the core syncs via SNTP every 30 minutes to prevent \'node suddenly broke\'.</string>
