    <!-- field hints -->
    <string name="hint_domain_suffix">Matches the domain and every subdomain: "google.com" also covers "mail.google.com".</string>
    <string name="hint_domain">Exact match on the full hostname, no subdomains.</string>
    <string name="hint_domain_keyword">Substring anywhere in the hostname — "ads" hits "ads.example.com" and "tracker-ads.net".</string>
    <string name="hint_domain_regex">Regular expression, matched as written.</string>
    <string name="hint_ip_cidr">Destination IP block, e.g. "8.8.8.8/32" or "10.0.0.0/8".</string>
    <string name="hint_source_ip_cidr">Where the connection comes from — on a phone that is the LAN or the tun address.</string>
    <string name="hint_port">Destination ports, comma separated: "443, 8443".</string>
    <string name="hint_source_port">Source port; rarely needed on mobile.</string>
    <string name="hint_port_range">Range written "start:end", e.g. "1000:2000".</string>
    <string name="hint_network">Which transport to match: tcp, udp, or both.</string>
    <string name="hint_protocol">Protocol detected by the sniffer — http, tls, quic and friends. Needs the sniffer enabled.</string>
    <string name="hint_package_name">Android package name, e.g. "com.android.chrome".</string>
    <string name="hint_rule_set">A downloaded rule set from the list above — this is how geosite-style lists plug in.</string>
    <string name="hint_outbound">Where matching traffic goes: a node, a group, the main selector, or direct.</string>
    <string name="hint_invert">Flip the match: everything that does NOT match the fields above.</string>
    <string name="hint_action">Route sends the connection to the outbound; Reject drops it; Resolve only resolves the domain and lets later rules decide.</string>

