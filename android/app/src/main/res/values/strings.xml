    <string name="settings_ip_family">Address family policy</string>
    <string name="settings_ip_family_desc">How DNS answers and connections choose between IPv4 and IPv6. prefer_* tries both and keeps the preferred one; *_only never uses the other. A network without usable IPv6 downgrades to prefer_ipv4 automatically.</string>
    <string name="settings_prefer_ipv6">Prefer IPv6</string>
