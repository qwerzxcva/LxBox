    <string name="preset_block_ads">Block ads</string>
    <string name="preset_block_ads_desc">Reject ad and tracker domains. Downloads a ~1 MB rule set on first use.</string>
    <string name="preset_private_ip">Private IPs</string>
    <string name="preset_private_ip_desc">Route LAN and private ranges directly. Keeps local devices reachable while the tunnel is up.</string>
    <string name="preset_bittorrent">BitTorrent</string>
    <string name="preset_bittorrent_desc">Route BitTorrent traffic directly instead of through the proxy.</string>
    <string name="preset_vowifi">VoWiFi (carrier calling)</string>
    <string name="preset_vowifi_desc">Keep Wi-Fi Calling off the tunnel: the carrier IMS gateway (epdg) and its IKEv2 ports stay direct, so calls do not pick up extra latency.</string>
    <string name="preset_fcm">Google push (FCM)</string>
    <string name="preset_fcm_desc">Send only FCM push traffic (ports 5228-5230 and Google push hosts) outside the tunnel, so notifications arrive promptly with the screen off.</string>

