    <string name="settings_ipv6_desc">Enable IPv6 routing through the tun interface.</string>
    <string name="settings_mtu">MTU: %1$d</string>
    <string name="settings_udp_over_tcp">UDP over TCP (VLESS)</string>
    <string name="settings_udp_over_tcp_desc">Carry UDP inside the VLESS TCP stream (packet-addr). Helps when the server or network blocks real UDP; needs server support (Xray/sing-box).</string>
    <string name="routes_client_subnet">EDNS client subnet (ECS)</string>
    <string name="hint_client_subnet">Sent to upstream DNS resolvers for this rule, e.g. 1.2.3.0/24 — geo-aware answers without leaking your real subnet.</string>
    <string name="routes_json_multiline_hint">One raw sing-box rule object per line, or a single object; pretty-printed works too.</string>
    <string name="subs_ech">Encrypted Client Hello (ECH)</string>
    <string name="subs_ech_desc">Wrap the TLS ClientHello of vless+TLS nodes from this subscription. Empty config = the core fetches the ECH config automatically from DNS.</string>
    <string name="subs_ech_query_name">ECH query name (optional)</string>
    <string name="subs_ech_query_name_hint">Defaults to each node TLS server name</string>
    <string name="subs_ech_config">ECH config list (optional, base64)</string>
    <string name="subs_ech_config_hint">Leave empty to auto-fetch from the node DNS HTTPS record</string>
    <string name="subs_edit">Edit subscription</string>
    <string name="dns_response_rcode">Response rcode</string>
    <string name="dns_response_rcode_hint">Match DNS responses by return code, e.g. NOERROR, NXDOMAIN, SERVFAIL.</string>
    <string name="routes_sync_dns_desc">lxbox-style: the compiler derives a DNS rule from the domain matchers of this rule — nothing is copied into the DNS rule list.</string>
    <string name="routes_sync_dns_server">DNS resolution for this rule</string>
    <string name="routes_sync_dns_none">Follow default</string>
    <string name="routes_sync_dns_na">IP-only rule: no DNS rule is created (matches happen on resolved addresses).</string>
    <string name="routes_section_builtin">Built-in</string>
    <string name="routes_fakeip_bypass">Fake-IP bypass rule</string>
    <string name="routes_fakeip_bypass_desc">Send packets addressed to the fake-IP range straight to direct — protects against apps caching fake addresses past the tunnel lifetime. Needs Fake-IP enabled.</string>
    <string name="routes_unknown_traffic">Unknown traffic (final) exit</string>
    <string name="routes_unknown_traffic_proxy">Proxy (default)</string>
    <string name="routes_unknown_traffic_desc">Where connections go when no rule matched: the main proxy selector, a node/group, or direct.</string>
    <string name="groups_unified_delay">Unified delay</string>
    <string name="groups_unified_delay_desc">Show one shared delay for the group instead of per-node values (urltest_unified_delay).</string>
    <string name="settings_hev_tun">Lightweight TUN mode (HEV)</string>
