    <!-- settings -->
    <string name="settings_section_appearance">Appearance</string>
    <string name="settings_section_tunnel">Tunnel</string>
    <string name="settings_section_power">Battery &amp; background</string>
    <string name="settings_battery_ok">Battery optimization is disabled for AIBox — the system won\'t freeze the tunnel in the background.</string>
    <string name="settings_battery_prompt">AIBox is subject to battery optimization: the system may freeze the tunnel in the background.</string>
    <string name="settings_battery_action">Exempt from battery optimization</string>
    <string name="settings_battery_app_settings">Open app system settings</string>
    <string name="settings_battery_manual_hint">If the dialog does not appear: Settings → Apps → AIBox → Battery → Unrestricted.</string>
    <string name="settings_battery_tunnel_policy">Tunnel power policy</string>
    <string name="settings_battery_tunnel_policy_desc">Screen off pauses the tunnel and closes idle connections. Doze deep-suspend stops the kernel timers entirely; the next wake resets the network so pushes arrive fresh. Network switches (Wi-Fi ↔ cellular) close half-dead sockets and reload the config automatically.</string>
    <string name="settings_section_mux">Multiplex (mux)</string>
    <string name="settings_mux_enable">Enable multiplexing</string>
    <string name="settings_mux_enable_desc">Carry many streams over one connection. Fewer handshakes, lower latency on reconnect — and it helps against servers that rate-limit new connections.</string>
    <string name="settings_mux_protocol">Protocol</string>
    <string name="settings_mux_protocol_h2mux">h2mux</string>
    <string name="settings_mux_protocol_smux">smux</string>
    <string name="settings_mux_protocol_yamux">yamux</string>
    <string name="settings_mux_protocol_desc">h2mux is the default and the one most panels expect; smux has a smaller frame overhead; yamux keeps a window per stream and is the most throughput-friendly.</string>
    <string name="settings_mux_max_connections">Max connections</string>
    <string name="settings_mux_max_connections_desc">Upper bound of carrier connections kept open. Empty = engine default.</string>
    <string name="settings_mux_min_streams">Min streams</string>
    <string name="settings_mux_min_streams_desc">A carrier with fewer live streams is replaced once its count drops below this. Empty = engine default (8).</string>
    <string name="settings_mux_max_streams">Max streams</string>
    <string name="settings_mux_max_streams_desc">Hard cap on concurrent streams per carrier connection. Empty = engine default.</string>
    <string name="settings_mux_padding">Frame padding</string>
    <string name="settings_mux_padding_desc">Pad mux frames to obscure their length. Costs a little bandwidth; hides traffic shape.</string>
    <string name="settings_mux_brutal">Brutal congestion control</string>
    <string name="settings_mux_brutal_desc">Ignore the congestion window and send at a fixed rate. Great on lossy long-haul links, but it saturates the link — bandwidth is taken from other traffic on the same wire.</string>
    <string name="settings_mux_brutal_up">Brutal upload</string>
    <string name="settings_mux_brutal_down">Brutal download</string>
    <string name="settings_mux_default">default</string>
    <string name="settings_mux_brutal_hint">Set to roughly 80% of your line speed so the carrier link stays stable.</string>
    <string name="settings_mux_flow_hint">Nodes carrying a flow value (xtls-rprx-vision) bypass mux automatically — the combination is rejected by the core.</string>

