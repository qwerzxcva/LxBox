    <string name="settings_section_power">电池与后台</string>
    <string name="settings_battery_ok">AIBox 已免除电池优化 — 系统不会在后台冻结隧道。</string>
    <string name="settings_battery_prompt">AIBox 受电池优化限制：系统可能在后冻结隧道。</string>
    <string name="settings_battery_action">免除电池优化</string>
    <string name="settings_battery_app_settings">打开系统应用设置</string>
    <string name="settings_battery_manual_hint">如果弹窗未出现：设置 → 应用 → AIBox → 电池 → 不受限制。</string>
    <string name="settings_battery_tunnel_policy">隧道省电策略</string>
    <string name="settings_battery_tunnel_policy_desc">熄屏时暂停隧道并关闭空闲连接；进入 Doze 深暂停（彻底停内核定时器），下次唤醒重置网络以恢复推送。网络切换（Wi-Fi ↔ 蜂窝）自动关闭半死连接并重载配置。</string>
    <string name="settings_section_mux">多路复用（mux）</string>
    <string name="settings_mux_enable">启用多路复用</string>
    <string name="settings_mux_enable_desc">多个流共用一条连接：减少握手、重连更快，也能绕过限制新连接的服务端。</string>
    <string name="settings_mux_protocol">协议</string>
    <string name="settings_mux_protocol_h2mux">h2mux</string>
    <string name="settings_mux_protocol_smux">smux</string>
    <string name="settings_mux_protocol_yamux">yamux</string>
    <string name="settings_mux_protocol_desc">h2mux 是默认值也是多数服务端的预期；smux 帧开销更小；yamux 每流带窗口，吞吐表现最好。</string>
    <string name="settings_mux_max_connections">最大连接数</string>
    <string name="settings_mux_max_connections_desc">承载连接的数量上限。留空 = 内核默认。</string>
    <string name="settings_mux_min_streams">最小流数</string>
    <string name="settings_mux_min_streams_desc">承载连接上活跃流低于此值时会提前新建连接。留空 = 内核默认（8）。</string>
    <string name="settings_mux_max_streams">最大流数</string>
    <string name="settings_mux_max_streams_desc">单条承载连接上的并发流上限。留空 = 内核默认。</string>
    <string name="settings_mux_padding">帧填充</string>
    <string name="settings_mux_padding_desc">对 mux 帧填充以隐藏长度特征。会稍微增加流量开销。</string>
    <string name="settings_mux_brutal">Brutal 拥塞控制</string>
    <string name="settings_mux_brutal_desc">忽略塞塞窗口按固定速率发送。高丢包长链路上提升明显，但会占满带宽、影响同线路其他流量。</string>
    <string name="settings_mux_brutal_up">Brutal 上行</string>
    <string name="settings_mux_brutal_down">Brutal 下行</string>
    <string name="settings_mux_default">默认</string>
    <string name="settings_mux_brutal_hint">建议设为实际带宽的约 80%，保证链路稳定。</string>
    <string name="settings_mux_flow_hint">带 flow（xtls-rprx-vision）的节点会自动跳过 mux——内核不允许两者共存。</string>

